{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "permissions": [
    {
      "action": "shell",
      "resource": "bootdev run *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask",
    },
    {
      "action": "shell",
      "resource": "bootdev run *",
      "effect": "allow",
    },
    {
      "action": "run_slop",
      "resource": "*",
      "effect": "allow",
    },
    {
      "action": "subagent",
      "resource": "explore",
      "effect": "deny",
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny",
    },
    {
      "action": "skill",
      "resource": "create-test-program",
      "effect": "ask",
    },
  ],
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
      },
      "notion": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp",
        "disabled": true,
      },
    },
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 10000,
    },
    "buffer": 20000,
  },
  "watcher": {
    "ignore": ["logs/**"],
  },
}
